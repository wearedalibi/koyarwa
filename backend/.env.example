# ─────────────────────────────────────────────────────────────
# Koyarwa — configuration backend (tout est piloté par l'environnement)
# Copier en .env et ajuster. Rien n'est en dur côté code.
# ─────────────────────────────────────────────────────────────

# App (préfixe APP_)
APP_NAME=Koyarwa
APP_ENV=dev            # dev | staging | prod
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1
APP_HOST=127.0.0.1     # loopback par défaut ; le conteneur force 0.0.0.0
APP_PORT=8000

# Database (préfixe DB_) — l'URL est composée à partir de ces champs
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=5433           # décalé de 5432 pour éviter un conflit avec un Postgres local
DB_USER=koyarwa
DB_PASSWORD=koyarwa
DB_NAME=koyarwa
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# CORS (préfixe CORS_) — origines séparées par des virgules
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Rate limiting (préfixe RATELIMIT_) — fenêtre glissante par IP (défense en profondeur)
RATELIMIT_ENABLED=true
RATELIMIT_REQUESTS=120  # requêtes autorisées par fenêtre et par client
RATELIMIT_WINDOW_SECONDS=60

# Admin back-office (préfixe ADMIN_) — auth par session (cookie signé)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Clé de signature des cookies — À SURCHARGER en prod (ex. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=dev-insecure-change-me

# Optionnel : forcer un autre fichier d'env
# ENV_FILE=/chemin/vers/.env
